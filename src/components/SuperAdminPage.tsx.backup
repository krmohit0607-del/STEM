import { useEffect, useState } from 'react';
import { superAdminApi } from '../api/superAdminApi';
import type { CreateTenantUserRequestDto, ModuleDto, TenantDto, TenantModuleAccessDto, TenantUserDto, TenantUserRole } from '../types/auth';

const SYSTEM_MODULE_NAMES = new Set(['Chartering', 'Operations', 'Bunker', 'Postfix', 'Emissions', 'Performance', 'Accounts']);

export function SuperAdminPage() {
  const [tenants, setTenants] = useState<TenantDto[]>([]);
  const [modules, setModules] = useState<ModuleDto[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [successMsg, setSuccessMsg] = useState<string | null>(null);

  // Workspace state
  const [selectedTenant, setSelectedTenant] = useState<TenantDto | null>(null);
  const [activeTab, setActiveTab] = useState<'users' | 'roles' | 'modules' | 'settings'>('users');
  const [tenantUsers, setTenantUsers] = useState<TenantUserDto[]>([]);
  const [tenantModuleAccessList, setTenantModuleAccessList] = useState<TenantModuleAccessDto[]>([]);
  const [isLoadingTenantData, setIsLoadingTenantData] = useState(false);

  // User management
  const [userSearch, setUserSearch] = useState('');
  const [selectedUser, setSelectedUser] = useState<TenantUserDto | null>(null);
  const [showCreateUserModal, setShowCreateUserModal] = useState(false);
  const [userDraft, setUserDraft] = useState<CreateTenantUserRequestDto>({ tenantId: '', fullName: '', email: '', password: '', role: 'Employee' });
  const [editingUserDetails, setEditingUserDetails] = useState<TenantUserDto | null>(null);
  const [editingUser, setEditingUser] = useState<TenantUserDto | null>(null);

  // Create company modal
  const [showCreateTenantModal, setShowCreateTenantModal] = useState(false);
  const [companyName, setCompanyName] = useState('');
  const [adminFullName, setAdminFullName] = useState('');
  const [adminEmail, setAdminEmail] = useState('');
  const [adminPassword, setAdminPassword] = useState('');
  const [selectedInitialModules, setSelectedInitialModules] = useState<string[]>([]);

  const [isSavingTenant, setIsSavingTenant] = useState(false);

  const loadData = async () => {
    setIsLoading(true);
    setError(null);
    try {
      const [tenantsData, modulesData] = await Promise.all([
        superAdminApi.getAdmins(),
        superAdminApi.getModules(),
      ]);
      setTenants(tenantsData ?? []);
      setModules((modulesData ?? []).filter((module) => SYSTEM_MODULE_NAMES.has(module.name)));
      if ((tenantsData?.length ?? 0) > 0 && !selectedTenant) {
        setSelectedTenant(tenantsData![0]);
      }
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Failed to load SuperAdmin data.');
    } finally {
      setIsLoading(false);
    }
  };

  const loadTenantData = async (tenant: TenantDto) => {
    setIsLoadingTenantData(true);
    try {
      const [users, access] = await Promise.all([
        superAdminApi.getTenantUsers(tenant.id),
        superAdminApi.getTenantModuleAccess(tenant.id),
      ]);
      setTenantUsers(users);
      setTenantModuleAccessList(access);
      setSelectedUser(null);
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Failed to load tenant data.');
    } finally {
      setIsLoadingTenantData(false);
    }
  };

  useEffect(() => {
    void loadData();
  }, []);

  useEffect(() => {
    if (selectedTenant) {
      void loadTenantData(selectedTenant);
    }
  }, [selectedTenant]);

  const handleCreateTenant = async (e: React.FormEvent) => {
    e.preventDefault();
    setIsSavingTenant(true);
    setError(null);
    try {
      await superAdminApi.createAdmin({
        companyName,
        adminFullName,
        adminEmail,
        adminPassword,
        initialModuleIds: selectedInitialModules,
      });
      setSuccessMsg(`Company "${companyName}" created successfully!`);
      setShowCreateTenantModal(false);
      setCompanyName('');
      setAdminFullName('');
      setAdminEmail('');
      setAdminPassword('');
      setSelectedInitialModules([]);
      await loadData();
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Failed to create company.');
    } finally {
      setIsSavingTenant(false);
    }
  };

  const handleToggleTenantStatus = async (tenant: TenantDto) => {
    try {
      await superAdminApi.updateTenantStatus(tenant.id, {
        isActive: !tenant.isActive,
      });
      setSuccessMsg(`Company status updated.`);
      if (selectedTenant?.id === tenant.id) {
        setSelectedTenant({ ...selectedTenant, isActive: !selectedTenant.isActive });
      }
      await loadData();
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Failed to update company status.');
    }
  };

  const handleCreateUser = async (event: React.FormEvent) => {
    event.preventDefault();
    if (!selectedTenant) return;
    setError(null);
    try {
      await superAdminApi.createTenantUser({ ...userDraft, tenantId: selectedTenant.id });
      setSuccessMsg(`User "${userDraft.fullName}" created.`);
      setShowCreateUserModal(false);
      setUserDraft({ tenantId: selectedTenant.id, fullName: '', email: '', password: '', role: 'Employee' });
      await loadTenantData(selectedTenant);
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Failed to create user.');
    }
  };

  const saveUserDetails = async (event: React.FormEvent) => {
    event.preventDefault();
    if (!editingUserDetails || !selectedTenant) return;
    try {
      await superAdminApi.updateTenantUser(editingUserDetails.id, {
        fullName: editingUserDetails.fullName,
        phoneNumber: editingUserDetails.phoneNumber ?? '',
        assignedVesselImo: editingUserDetails.assignedVesselImo ?? '',
        assignedVesselName: editingUserDetails.assignedVesselName ?? '',
        isActive: editingUserDetails.isActive,
      });
      setEditingUserDetails(null);
      await loadTenantData(selectedTenant);
      setSuccessMsg(`User "${editingUserDetails.fullName}" updated.`);
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Failed to update user.');
    }
  };

  const deactivateUser = async (user: TenantUserDto) => {
    if (!selectedTenant || !window.confirm(`Deactivate ${user.fullName}?`)) return;
    try {
      await superAdminApi.deleteTenantUser(user.id);
      await loadTenantData(selectedTenant);
      setSuccessMsg(`${user.fullName} was deactivated.`);
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Failed to deactivate user.');
    }
  };

  const toggleUserPermission = (moduleId: string, field: 'canView' | 'canCreate' | 'canEdit' | 'canDelete') => {
    if (!editingUser) return;
    const existing = editingUser.permissions.find((p) => p.moduleId === moduleId);
    const next = editingUser.permissions.filter((p) => p.moduleId !== moduleId);
    const row = existing ?? { moduleId, moduleName: '', canView: false, canCreate: false, canEdit: false, canDelete: false };
    const updated = { ...row, [field]: !row[field] };
    if (field !== 'canView' && updated[field]) updated.canView = true;
    setEditingUser({ ...editingUser, permissions: [...next, updated] });
  };

  const saveUserPermissions = async () => {
    if (!editingUser || !selectedTenant) return;
    try {
      await superAdminApi.setTenantUserPermissions(editingUser.id, {
        userId: editingUser.id,
        permissions: editingUser.permissions.map(({ moduleName, ...permission }) => permission),
      });
      setSuccessMsg(`Permissions updated for ${editingUser.fullName}.`);
      setEditingUser(null);
      await loadTenantData(selectedTenant);
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Failed to save user permissions.');
    }
  };

  const handleToggleModuleAccess = async (moduleId: string, currentEnabled: boolean) => {
    if (!selectedTenant) return;
    try {
      await superAdminApi.setTenantModuleAccess({
        tenantId: selectedTenant.id,
        moduleId,
        isEnabled: !currentEnabled,
      });
      await loadTenantData(selectedTenant);
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Failed to update module access.');
    }
  };

  const filteredUsers = userSearch.trim() ? tenantUsers.filter((u) => `${u.fullName} ${u.email} ${u.role}`.toLowerCase().includes(userSearch.toLowerCase())) : tenantUsers;

  const roleLabel = (role: string) => {
    switch (role) {
      case 'Admin':
        return 'Manager';
      case 'Employee':
        return 'Executive';
      case 'VesselMaster':
        return 'Vessel';
      default:
        return role;
    }
  };

  return (
    <div style={{ display: 'flex', flexDirection: 'column', height: '100vh', background: '#0f1419' }}>
      <header style={{ padding: '1.25rem 1.5rem', borderBottom: '1px solid #1e2d42', background: '#101820' }}>
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
          <div>
            <h1 style={{ margin: '0 0 0.25rem', color: '#f3f7fc', fontSize: '1.5rem' }}>User Control Centre</h1>
            <p style={{ margin: 0, color: '#8fa2bc', fontSize: '13px' }}>Manage companies, users, roles and module access</p>
          </div>
          <button type="button" onClick={() => setShowCreateTenantModal(true)} style={{ background: '#2563eb', color: '#fff', border: 0, padding: '0.5rem 1rem', borderRadius: '6px', cursor: 'pointer', fontWeight: 600, display: 'flex', alignItems: 'center', gap: '0.5rem' }}><i className="fas fa-plus" /> Add Company</button>
        </div>
      </header>

      {/* Notifications */}
      {error && (
        <div style={{ margin: '0.75rem 1rem', padding: '0.8rem 1rem', background: '#2b1720', border: '1px solid #5a2a2a', borderRadius: '6px', color: '#ffadad', display: 'flex', alignItems: 'center', gap: '0.6rem' }}>
          <i className="fas fa-circle-exclamation" /> {error}
        </div>
      )}
      {successMsg && (
        <div style={{ margin: '0.75rem 1rem', padding: '0.8rem 1rem', background: '#113225', border: '1px solid #2a5a3a', borderRadius: '6px', color: '#78e1a7', display: 'flex', alignItems: 'center', gap: '0.6rem' }}>
          <i className="fas fa-circle-check" /> {successMsg}
        </div>
      )}

      
      {isLoading ? (
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', flex: 1, color: '#8fa2bc' }}>
          <div><i className="fas fa-spinner fa-spin" style={{ fontSize: '2rem', marginBottom: '0.5rem' }} /><p>Loading...</p></div>
        </div>
      ) : (
        <div style={{ display: 'flex', flex: 1, overflow: 'hidden' }}>
          {/* Sidebar */}
          <aside style={{ width: '220px', background: '#101820', borderRight: '1px solid #1e2d42', padding: '1.5rem 1rem', overflow: 'auto', display: 'flex', flexDirection: 'column', gap: '1.5rem' }}>
            <div>
              <div style={{ color: '#8fa2bc', fontSize: '11px', fontWeight: 700, textTransform: 'uppercase', marginBottom: '0.5rem', letterSpacing: '0.5px' }}>Select Company</div>
              <select value={selectedTenant?.id ?? ''} onChange={(e) => setSelectedTenant(tenants.find((t) => t.id === e.target.value) ?? null)} style={{ width: '100%', padding: '0.5rem', background: '#0a1118', border: '1px solid #1e2d42', borderRadius: '4px', color: '#e8eef8', font: 'inherit', cursor: 'pointer' }}>
                <option value="">-- Select --</option>
                {tenants.map((t) => <option key={t.id} value={t.id}>{t.companyName}</option>)}
              </select>
            </div>

            {selectedTenant && (
              <div style={{ padding: '1rem', background: '#0a1118', border: '1px solid #1e2d42', borderRadius: '6px', fontSize: '13px' }}>
                <div style={{ marginBottom: '0.75rem' }}>
                  <strong style={{ color: '#e8eef8', display: 'block' }}>{selectedTenant.companyName}</strong>
                  <div style={{ color: '#8fa2bc', fontSize: '11px', marginTop: '0.25rem' }}>{selectedTenant.adminEmail}</div>
                </div>
                <div style={{ display: 'grid', gap: '0.4rem', color: '#8fa2bc', fontSize: '12px', borderTop: '1px solid #1e2d42', paddingTop: '0.75rem' }}>
                  <div><strong style={{ color: '#e8eef8' }}>{selectedTenant.activeUsersCount}</strong> users</div>
                  <div><strong style={{ color: '#e8eef8' }}>{selectedTenant.enabledModulesCount}</strong> modules</div>
                  <div style={{ marginTop: '0.5rem' }}>
                    <span style={{ background: selectedTenant.isActive ? '#113225' : '#351c25', color: selectedTenant.isActive ? '#78e1a7' : '#ffadad', padding: '2px 6px', borderRadius: '3px', fontSize: '10px', fontWeight: 'bold' }}>
                      {selectedTenant.isActive ? 'ACTIVE' : 'SUSPENDED'}
                    </span>
                  </div>
                </div>
              </div>
            )}
          </aside>

          {/* Main Content */}
          {selectedTenant ? (
            <main style={{ flex: 1, display: 'flex', flexDirection: 'column', overflow: 'hidden' }}>
              {/* Tabs */}
              <div style={{ display: 'flex', borderBottom: '1px solid #1e2d42', background: '#0a1118' }}>
                {(['users', 'roles', 'modules', 'settings'] as const).map((tab) => (
                  <button
                    key={tab}
                    type="button"
                    onClick={() => { setActiveTab(tab); setSelectedUser(null); }}
                    style={{
                      flex: 1,
                      padding: '1rem',
                      background: activeTab === tab ? '#101820' : 'transparent',
                      border: 0,
                      borderBottom: activeTab === tab ? '2px solid #2563eb' : 'none',
                      color: activeTab === tab ? '#e8eef8' : '#8fa2bc',
                      cursor: 'pointer',
                      fontSize: '14px',
                      fontWeight: 600,
                      transition: 'all 0.2s',
                      display: 'flex',
                      alignItems: 'center',
                      gap: '0.5rem',
                      justifyContent: 'center',
                    }}
                  >
                    {tab === 'users' && <i className="fas fa-users" />}
                    {tab === 'roles' && <i className="fas fa-user-tag" />}
                    {tab === 'modules' && <i className="fas fa-layer-group" />}
                    {tab === 'settings' && <i className="fas fa-cog" />}
                    {tab[0].toUpperCase() + tab.slice(1)}
                  </button>
                ))}
              </div>

              {/* Content */}
              <div style={{ flex: 1, overflow: 'auto', display: 'flex' }}>
                {activeTab === 'users' && (
                  <div style={{ flex: 1, display: 'flex', flexDirection: 'column' }}>
                    {/* Search & Add */}
                    <div style={{ padding: '1.5rem', borderBottom: '1px solid #1e2d42', background: '#101820', display: 'flex', gap: '1rem', alignItems: 'center' }}>
                      <label style={{ display: 'flex', alignItems: 'center', gap: '6px', flex: 1, maxWidth: '300px', padding: '6px 10px', border: '1px solid #1e2d42', borderRadius: '4px', background: '#0a1118' }}>
                        <i className="fas fa-search" style={{ color: '#70b7ff' }} />
                        <input value={userSearch} onChange={(e) => setUserSearch(e.target.value)} placeholder="Search users..." style={{ flex: 1, border: 0, outline: 0, background: 'transparent', color: '#e8eef8', font: 'inherit' }} />
                      </label>
                      <button type="button" onClick={() => { setUserDraft({ tenantId: selectedTenant.id, fullName: '', email: '', password: '', role: 'Employee' }); setShowCreateUserModal(true); }} style={{ background: '#2563eb', color: '#fff', border: 0, padding: '0.5rem 0.8rem', borderRadius: '4px', cursor: 'pointer', fontWeight: 600, display: 'flex', alignItems: 'center', gap: '0.4rem', fontSize: '13px' }}><i className="fas fa-user-plus" /> Add User</button>
                    </div>

                    {/* Users Table + Detail Panel */}
                    <div style={{ flex: 1, display: 'flex', overflow: 'hidden' }}>
                      {/* Table */}
                      <div style={{ flex: selectedUser ? 0.6 : 1, borderRight: selectedUser ? '1px solid #1e2d42' : 'none', overflow: 'auto', display: 'flex', flexDirection: 'column' }}>
                        {isLoadingTenantData ? (
                          <div style={{ flex: 1, display: 'flex', alignItems: 'center', justifyContent: 'center', color: '#8fa2bc' }}>Loading...</div>
                        ) : filteredUsers.length === 0 ? (
                          <div style={{ flex: 1, display: 'flex', alignItems: 'center', justifyContent: 'center', color: '#8fa2bc' }}>No users found</div>
                        ) : (
                          <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '13px' }}>
                            <thead style={{ background: '#0a1118', position: 'sticky', top: 0 }}>
                              <tr style={{ borderBottom: '1px solid #1e2d42' }}>
                                <th style={{ padding: '10px 12px', textAlign: 'left', color: '#8fa2bc', fontWeight: 700, fontSize: '11px', textTransform: 'uppercase', letterSpacing: '0.5px' }}>Name</th>
                                <th style={{ padding: '10px 12px', textAlign: 'left', color: '#8fa2bc', fontWeight: 700, fontSize: '11px', textTransform: 'uppercase', letterSpacing: '0.5px' }}>Email</th>
                                <th style={{ padding: '10px 12px', textAlign: 'left', color: '#8fa2bc', fontWeight: 700, fontSize: '11px', textTransform: 'uppercase', letterSpacing: '0.5px' }}>Role</th>
                                <th style={{ padding: '10px 12px', textAlign: 'left', color: '#8fa2bc', fontWeight: 700, fontSize: '11px', textTransform: 'uppercase', letterSpacing: '0.5px' }}>Access</th>
                                <th style={{ padding: '10px 12px', textAlign: 'center', color: '#8fa2bc', fontWeight: 700, fontSize: '11px', textTransform: 'uppercase', letterSpacing: '0.5px' }}>Status</th>
                              </tr>
                            </thead>
                            <tbody>
                              {filteredUsers.map((user) => (
                                <tr
                                  key={user.id}
                                  onClick={() => setSelectedUser(user)}
                                  style={{
                                    borderBottom: '1px solid #1e2d42',
                                    background: selectedUser?.id === user.id ? '#1a3050' : 'transparent',
                                    cursor: 'pointer',
                                    transition: 'background 0.15s',
                                  }}
                                  onMouseEnter={(e) => { if (selectedUser?.id !== user.id) e.currentTarget.style.background = '#0f2135'; }}
                                  onMouseLeave={(e) => { if (selectedUser?.id !== user.id) e.currentTarget.style.background = 'transparent'; }}
                                >
                                  <td style={{ padding: '10px 12px', color: '#e8eef8', fontWeight: 500 }}>{user.fullName}</td>
                                  <td style={{ padding: '10px 12px', color: '#8fa2bc' }}>{user.email}</td>
                                  <td style={{ padding: '10px 12px' }}><span style={{ padding: '2px 6px', borderRadius: '3px', fontSize: '11px', fontWeight: 700, background: '#1a3d6e', color: '#74c1ff' }}>{roleLabel(user.role)}</span></td>
                                  <td style={{ padding: '10px 12px', color: '#8fa2bc' }}>{user.permissions.length}/{modules.length}</td>
                                  <td style={{ padding: '10px 12px', textAlign: 'center' }}><span style={{ display: 'inline-block', width: '7px', height: '7px', borderRadius: '50%', background: user.isActive ? '#50d88d' : '#ef6262' }} /></td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        )}
                      </div>

                      {/* Detail Panel */}
                      {selectedUser && (
                        <div style={{ width: '360px', background: '#0a1118', borderLeft: '1px solid #1e2d42', padding: '1.5rem', overflow: 'auto', display: 'flex', flexDirection: 'column' }}>
                          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '1.5rem' }}>
                            <h3 style={{ margin: 0, color: '#e8eef8', fontSize: '1rem' }}>{selectedUser.fullName}</h3>
                            <button type="button" onClick={() => setSelectedUser(null)} style={{ background: 'none', border: 0, color: '#8fa2bc', fontSize: '1.1rem', cursor: 'pointer', padding: 0 }}>✕</button>
                          </div>

                          <div style={{ marginBottom: '1.5rem', fontSize: '12px' }}>
                            <div style={{ color: '#8fa2bc', marginBottom: '0.35rem' }}>{selectedUser.email}</div>
                            <div style={{ color: '#8fa2bc', marginBottom: '0.35rem' }}>Role: <strong style={{ color: '#e8eef8' }}>{roleLabel(selectedUser.role)}</strong></div>
                            {selectedUser.assignedVesselName && <div style={{ color: '#8fa2bc' }}>Vessel: <strong style={{ color: '#e8eef8' }}>{selectedUser.assignedVesselName}</strong> ({selectedUser.assignedVesselImo})</div>}
                          </div>

                          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '0.6rem', marginBottom: '1.5rem' }}>
                            <button type="button" onClick={() => setEditingUserDetails({ ...selectedUser })} style={{ padding: '0.5rem 0.8rem', border: '1px solid #1e2d42', borderRadius: '4px', color: '#8fa2bc', background: '#101820', cursor: 'pointer', fontSize: '12px', fontWeight: 600 }}>Edit</button>
                            <button type="button" onClick={() => setEditingUser(selectedUser)} style={{ padding: '0.5rem 0.8rem', border: '1px solid #1e2d42', borderRadius: '4px', color: '#8fa2bc', background: '#101820', cursor: 'pointer', fontSize: '12px', fontWeight: 600 }}>Permissions</button>
                          </div>

                          <button type="button" onClick={() => void deactivateUser(selectedUser)} style={{ width: '100%', padding: '0.5rem', border: '1px solid #5a2a2a', borderRadius: '4px', color: '#ffadad', background: '#2b1720', cursor: 'pointer', fontSize: '12px', fontWeight: 600 }}>Deactivate</button>
                        </div>
                      )}
                    </div>
                  </div>
                )}

                {activeTab === 'roles' && (
                  <div style={{ flex: 1, padding: '2rem' }}>
                    <h2 style={{ margin: '0 0 0.5rem', color: '#e8eef8' }}>Roles &amp; Permissions</h2>
                    <p style={{ color: '#8fa2bc', marginBottom: '1.5rem' }}>Configure user role assignments and access levels.</p>
                    <div style={{ padding: '1.5rem', border: '1px solid #1e2d42', borderRadius: '6px', background: '#101820', color: '#8fa2bc', fontSize: '13px', lineHeight: '1.6' }}>
                      <p><strong>Available roles:</strong></p>
                      <ul style={{ margin: '0.5rem 0 0 1.5rem', paddingLeft: 0 }}>
                        <li><strong>Manager</strong> (Admin) - Full administrative access</li>
                        <li><strong>Executive</strong> (Employee) - Operational user access</li>
                        <li><strong>Vessel</strong> (VesselMaster) - Vessel-specific access</li>
                      </ul>
                      <p style={{ marginTop: '1rem' }}>Edit individual user permissions in the Users tab.</p>
                    </div>
                  </div>
                )}

                {activeTab === 'modules' && (
                  <div style={{ flex: 1, padding: '2rem', overflow: 'auto' }}>
                    <h2 style={{ margin: '0 0 0.5rem', color: '#e8eef8' }}>Module Access</h2>
                    <p style={{ color: '#8fa2bc', fontSize: '13px', marginBottom: '1.5rem' }}>Enable or disable maritime modules for this company</p>
                    {isLoadingTenantData ? (
                      <div style={{ color: '#8fa2bc' }}>Loading...</div>
                    ) : (
                      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(220px, 1fr))', gap: '1rem' }}>
                        {modules.map((module) => {
                          const access = tenantModuleAccessList.find((a) => a.moduleId === module.id);
                          return (
                            <div key={module.id} style={{ padding: '1rem', border: '1px solid #1e2d42', borderRadius: '6px', background: '#0a1118' }}>
                              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '0.5rem' }}>
                                <strong style={{ color: '#e8eef8', fontSize: '13px' }}>{module.name}</strong>
                                <button type="button" onClick={() => handleToggleModuleAccess(module.id, access?.isEnabled ?? false)} style={{ padding: '3px 8px', border: 0, borderRadius: '3px', background: access?.isEnabled ? '#2a6e3e' : '#3a3a4a', color: access?.isEnabled ? '#50d88d' : '#8fa2bc', cursor: 'pointer', fontSize: '10px', fontWeight: 600 }}>{access?.isEnabled ? 'Enabled' : 'Disabled'}</button>
                              </div>
                              <p style={{ color: '#8fa2bc', fontSize: '11px', margin: '0', lineHeight: '1.4' }}>{module.description || '—'}</p>
                            </div>
                          );
                        })}
                      </div>
                    )}
                  </div>
                )}

                {activeTab === 'settings' && (
                  <div style={{ flex: 1, padding: '2rem', overflow: 'auto' }}>
                    <h2 style={{ margin: '0 0 1.5rem', color: '#e8eef8' }}>Company Settings</h2>
                    <div style={{ padding: '1.5rem', border: '1px solid #1e2d42', borderRadius: '6px', background: '#0a1118' }}>
                      <div style={{ marginBottom: '1rem' }}>
                        <label style={{ display: 'block', color: '#8fa2bc', fontSize: '11px', fontWeight: 700, marginBottom: '0.35rem', textTransform: 'uppercase', letterSpacing: '0.5px' }}>Company Name</label>
                        <div style={{ color: '#e8eef8', fontWeight: 500 }}>{selectedTenant.companyName}</div>
                      </div>
                      <div style={{ marginBottom: '1rem' }}>
                        <label style={{ display: 'block', color: '#8fa2bc', fontSize: '11px', fontWeight: 700, marginBottom: '0.35rem', textTransform: 'uppercase', letterSpacing: '0.5px' }}>Administrator</label>
                        <div style={{ color: '#e8eef8', fontWeight: 500 }}>{selectedTenant.adminFullName}</div>
                        <div style={{ color: '#8fa2bc', fontSize: '12px' }}>{selectedTenant.adminEmail}</div>
                      </div>
                      <div>
                        <label style={{ display: 'block', color: '#8fa2bc', fontSize: '11px', fontWeight: 700, marginBottom: '0.35rem', textTransform: 'uppercase', letterSpacing: '0.5px' }}>Status</label>
                        <button type="button" onClick={() => void handleToggleTenantStatus(selectedTenant)} style={{ padding: '0.5rem 1rem', border: '1px solid ' + (selectedTenant.isActive ? '#5a2a2a' : '#2a4a2a'), borderRadius: '4px', background: selectedTenant.isActive ? '#2b1720' : '#102720', color: selectedTenant.isActive ? '#ffadad' : '#9ce8c0', cursor: 'pointer', fontSize: '12px', fontWeight: 600 }}>{selectedTenant.isActive ? 'Deactivate' : 'Activate'}</button>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </main>
          ) : (
            <main style={{ flex: 1, display: 'flex', alignItems: 'center', justifyContent: 'center', color: '#8fa2bc' }}>
              <p>Select a company to manage</p>
            </main>
          )}
        </div>
      )}

                {activeTab === 'roles' && (
                  <div style={{ flex: 1, padding: '2rem' }}>
                    <h2 style={{ margin: '0 0 0.5rem', color: '#e8eef8' }}>Roles &amp; Permissions</h2>
                    <p style={{ color: '#8fa2bc', marginBottom: '1.5rem' }}>Configure user role assignments and access levels.</p>
                    <div style={{ padding: '1.5rem', border: '1px solid #1e2d42', borderRadius: '6px', background: '#101820', color: '#8fa2bc', fontSize: '13px', lineHeight: '1.6' }}>
                      <p><strong>Available roles:</strong></p>
                      <ul style={{ margin: '0.5rem 0 0 1.5rem', paddingLeft: 0 }}>
                        <li><strong>Manager</strong> (Admin) - Full administrative access</li>
                        <li><strong>Executive</strong> (Employee) - Operational user access</li>
                        <li><strong>Vessel</strong> (VesselMaster) - Vessel-specific access</li>
                      </ul>
                      <p style={{ marginTop: '1rem' }}>Edit individual user permissions in the Users tab.</p>
                    </div>
                  </div>
                )}

                {activeTab === 'modules' && (
                  <div style={{ flex: 1, padding: '2rem', overflow: 'auto' }}>
                    <h2 style={{ margin: '0 0 0.5rem', color: '#e8eef8' }}>Module Access</h2>
                    <p style={{ color: '#8fa2bc', fontSize: '13px', marginBottom: '1.5rem' }}>Enable or disable maritime modules for this company</p>
                    {isLoadingTenantData ? (
                      <div style={{ color: '#8fa2bc' }}>Loading...</div>
                    ) : (
                      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(220px, 1fr))', gap: '1rem' }}>
                        {modules.map((module) => {
                          const access = tenantModuleAccessList.find((a) => a.moduleId === module.id);
                          return (
                            <div key={module.id} style={{ padding: '1rem', border: '1px solid #1e2d42', borderRadius: '6px', background: '#0a1118' }}>
                              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '0.5rem' }}>
                                <strong style={{ color: '#e8eef8', fontSize: '13px' }}>{module.name}</strong>
                                <button type="button" onClick={() => handleToggleModuleAccess(module.id, access?.isEnabled ?? false)} style={{ padding: '3px 8px', border: 0, borderRadius: '3px', background: access?.isEnabled ? '#2a6e3e' : '#3a3a4a', color: access?.isEnabled ? '#50d88d' : '#8fa2bc', cursor: 'pointer', fontSize: '10px', fontWeight: 600 }}>{access?.isEnabled ? 'Enabled' : 'Disabled'}</button>
                              </div>
                              <p style={{ color: '#8fa2bc', fontSize: '11px', margin: '0', lineHeight: '1.4' }}>{module.description || '—'}</p>
                            </div>
                          );
                        })}
                      </div>
                    )}
                  </div>
                )}

                {activeTab === 'settings' && (
                  <div style={{ flex: 1, padding: '2rem', overflow: 'auto' }}>
                    <h2 style={{ margin: '0 0 1.5rem', color: '#e8eef8' }}>Company Settings</h2>
                    <div style={{ padding: '1.5rem', border: '1px solid #1e2d42', borderRadius: '6px', background: '#0a1118' }}>
                      <div style={{ marginBottom: '1rem' }}>
                        <label style={{ display: 'block', color: '#8fa2bc', fontSize: '11px', fontWeight: 700, marginBottom: '0.35rem', textTransform: 'uppercase', letterSpacing: '0.5px' }}>Company Name</label>
                        <div style={{ color: '#e8eef8', fontWeight: 500 }}>{selectedTenant.companyName}</div>
                      </div>
                      <div style={{ marginBottom: '1rem' }}>
                        <label style={{ display: 'block', color: '#8fa2bc', fontSize: '11px', fontWeight: 700, marginBottom: '0.35rem', textTransform: 'uppercase', letterSpacing: '0.5px' }}>Administrator</label>
                        <div style={{ color: '#e8eef8', fontWeight: 500 }}>{selectedTenant.adminFullName}</div>
                        <div style={{ color: '#8fa2bc', fontSize: '12px' }}>{selectedTenant.adminEmail}</div>
                      </div>
                      <div>
                        <label style={{ display: 'block', color: '#8fa2bc', fontSize: '11px', fontWeight: 700, marginBottom: '0.35rem', textTransform: 'uppercase', letterSpacing: '0.5px' }}>Status</label>
                        <button type="button" onClick={() => void handleToggleTenantStatus(selectedTenant)} style={{ padding: '0.5rem 1rem', border: '1px solid ' + (selectedTenant.isActive ? '#5a2a2a' : '#2a4a2a'), borderRadius: '4px', background: selectedTenant.isActive ? '#2b1720' : '#102720', color: selectedTenant.isActive ? '#ffadad' : '#9ce8c0', cursor: 'pointer', fontSize: '12px', fontWeight: 600 }}>{selectedTenant.isActive ? 'Deactivate' : 'Activate'}</button>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </main>
          ) : (
            <main style={{ flex: 1, display: 'flex', alignItems: 'center', justifyContent: 'center', color: '#8fa2bc' }}>
              <p>Select a company to manage</p>
            </main>
          )}
        </div>
      )}

      {/* Create User Modal */}
      {showCreateUserModal && selectedTenant && (
        <div style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.78)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 10000 }}>
          <form onSubmit={handleCreateUser} style={{ background: '#1e293b', padding: '1.5rem', borderRadius: '8px', width: 'min(500px, 94vw)', border: '1px solid #334155' }}>
            <h2 style={{ marginTop: 0 }}>Add User · {selectedTenant.companyName}</h2>
            {(['fullName', 'email', 'password'] as const).map((field) => (
              <label key={field} style={{ display: 'block', color: '#cbd5e1', marginBottom: '0.8rem' }}>
                {field === 'fullName' ? 'Full name' : field[0].toUpperCase() + field.slice(1)}
                <input
                  required
                  type={field === 'password' ? 'password' : field === 'email' ? 'email' : 'text'}
                  minLength={field === 'password' ? 8 : undefined}
                  value={userDraft[field]}
                  onChange={(e) => setUserDraft({ ...userDraft, [field]: e.target.value })}
                  style={{ display: 'block', width: '100%', boxSizing: 'border-box', marginTop: '0.25rem', padding: '0.55rem', background: '#0f172a', border: '1px solid #475569', color: '#fff', borderRadius: '4px' }}
                />
              </label>
            ))}
            <label style={{ display: 'block', color: '#cbd5e1', marginBottom: '1rem' }}>
              Role type
              <select value={userDraft.role} onChange={(e) => setUserDraft({ ...userDraft, role: e.target.value as TenantUserRole })} style={{ display: 'block', width: '100%', marginTop: '0.25rem', padding: '0.55rem', background: '#0f172a', border: '1px solid #475569', color: '#fff', borderRadius: '4px' }}>
                <option value="Admin">Manager</option>
                <option value="Employee">Executive</option>
                <option value="VesselMaster">Vessel</option>
              </select>
            </label>
            {userDraft.role === 'VesselMaster' && (
              <>
                <label style={{ display: 'block', color: '#cbd5e1', marginBottom: '0.8rem' }}>
                  Vessel name
                  <input value={userDraft.assignedVesselName ?? ''} onChange={(e) => setUserDraft({ ...userDraft, assignedVesselName: e.target.value })} style={{ display: 'block', width: '100%', boxSizing: 'border-box', marginTop: '0.25rem', padding: '0.55rem', background: '#0f172a', border: '1px solid #475569', color: '#fff', borderRadius: '4px' }} />
                </label>
                <label style={{ display: 'block', color: '#cbd5e1', marginBottom: '1rem' }}>
                  Vessel IMO
                  <input value={userDraft.assignedVesselImo ?? ''} onChange={(e) => setUserDraft({ ...userDraft, assignedVesselImo: e.target.value })} style={{ display: 'block', width: '100%', boxSizing: 'border-box', marginTop: '0.25rem', padding: '0.55rem', background: '#0f172a', border: '1px solid #475569', color: '#fff', borderRadius: '4px' }} />
                </label>
              </>
            )}
            <div style={{ marginBottom: '1rem' }}>
              <div style={{ color: '#cbd5e1', marginBottom: '0.4rem', fontSize: '13px', fontWeight: 600 }}>Initial module access</div>
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(2, minmax(0, 1fr))', gap: '0.4rem' }}>
                {modules.filter((module) => tenantModuleAccessList.some((access) => access.moduleId === module.id && access.isEnabled)).map((module) => (
                  <label key={module.id} style={{ display: 'flex', gap: '0.4rem', alignItems: 'center', color: '#cbd5e1', fontSize: '0.85rem' }}>
                    <input
                      type="checkbox"
                      checked={userDraft.initialModuleIds?.includes(module.id) ?? false}
                      onChange={(event) => {
                        const ids = userDraft.initialModuleIds ?? [];
                        setUserDraft({ ...userDraft, initialModuleIds: event.target.checked ? [...ids, module.id] : ids.filter((id) => id !== module.id) });
                      }}
                    />
                    {module.name}
                  </label>
                ))}
              </div>
            </div>
            <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '0.5rem' }}>
              <button type="button" onClick={() => setShowCreateUserModal(false)} style={{ background: '#334155', color: '#fff', border: 0, padding: '0.5rem 0.8rem', borderRadius: '4px', cursor: 'pointer' }}>Cancel</button>
              <button type="submit" style={{ background: '#2563eb', color: '#fff', border: 0, padding: '0.5rem 0.8rem', borderRadius: '4px', cursor: 'pointer' }}>Add User</button>
            </div>
          </form>
        </div>
      )}

      {/* Edit User Details Modal */}
      {editingUserDetails && (
        <div style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.78)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 10000 }}>
          <form onSubmit={saveUserDetails} style={{ background: '#1e293b', padding: '1.5rem', borderRadius: '8px', width: 'min(500px, 94vw)', border: '1px solid #334155' }}>
            <h2 style={{ marginTop: 0 }}>Edit user</h2>
            <label style={{ display: 'block', color: '#cbd5e1', marginBottom: '0.8rem' }}>
              Full name
              <input required value={editingUserDetails.fullName} onChange={(e) => setEditingUserDetails({ ...editingUserDetails, fullName: e.target.value })} style={{ display: 'block', width: '100%', boxSizing: 'border-box', marginTop: '0.25rem', padding: '0.55rem', background: '#0f172a', border: '1px solid #475569', color: '#fff', borderRadius: '4px' }} />
            </label>
            <label style={{ display: 'block', color: '#cbd5e1', marginBottom: '0.8rem' }}>
              Phone
              <input value={editingUserDetails.phoneNumber ?? ''} onChange={(e) => setEditingUserDetails({ ...editingUserDetails, phoneNumber: e.target.value })} style={{ display: 'block', width: '100%', boxSizing: 'border-box', marginTop: '0.25rem', padding: '0.55rem', background: '#0f172a', border: '1px solid #475569', color: '#fff', borderRadius: '4px' }} />
            </label>
            <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', color: '#cbd5e1', marginBottom: '1rem' }}>
              <input type="checkbox" checked={editingUserDetails.isActive} onChange={(e) => setEditingUserDetails({ ...editingUserDetails, isActive: e.target.checked })} />
              Active user
            </label>
            <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '0.5rem' }}>
              <button type="button" onClick={() => setEditingUserDetails(null)} style={{ background: '#334155', color: '#fff', border: 0, padding: '0.5rem 0.8rem', borderRadius: '4px', cursor: 'pointer' }}>Cancel</button>
              <button type="submit" style={{ background: '#2563eb', color: '#fff', border: 0, padding: '0.5rem 0.8rem', borderRadius: '4px', cursor: 'pointer' }}>Save</button>
            </div>
          </form>
        </div>
      )}

      {/* Edit User Permissions Modal */}
      {editingUser && selectedTenant && (
        <div style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.78)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 10000 }}>
          <div style={{ background: '#1e293b', padding: '1.5rem', borderRadius: '8px', width: 'min(650px, 94vw)', border: '1px solid #334155' }}>
            <h2 style={{ marginTop: 0 }}>Module access · {editingUser.fullName}</h2>
            <p style={{ color: '#94a3b8', fontSize: '13px' }}>Only modules enabled for {selectedTenant.companyName} can be assigned.</p>
            <div style={{ display: 'grid', gap: '0.8rem', marginBottom: '1.5rem' }}>
              {modules
                .filter((module) => tenantModuleAccessList.some((access) => access.moduleId === module.id && access.isEnabled))
                .map((module) => {
                  const permission = editingUser.permissions.find((p) => p.moduleId === module.id);
                  return (
                    <div key={module.id} style={{ display: 'grid', gridTemplateColumns: '1fr auto auto auto auto', gap: '0.8rem', alignItems: 'center', padding: '0.8rem', border: '1px solid #334155', borderRadius: '4px' }}>
                      <strong style={{ color: '#e8eef8' }}>{module.name}</strong>
                      {(['canView', 'canCreate', 'canEdit', 'canDelete'] as const).map((field) => (
                        <label key={field} style={{ display: 'flex', alignItems: 'center', gap: '0.3rem', color: '#cbd5e1', fontSize: '12px' }}>
                          <input type="checkbox" checked={Boolean(permission?.[field])} onChange={() => toggleUserPermission(module.id, field)} />
                          {field.replace('can', '')}
                        </label>
                      ))}
                    </div>
                  );
                })}
            </div>
            <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '0.5rem' }}>
              <button type="button" onClick={() => setEditingUser(null)} style={{ background: '#334155', color: '#fff', border: 0, padding: '0.5rem 0.8rem', borderRadius: '4px', cursor: 'pointer' }}>Cancel</button>
              <button type="button" onClick={() => void saveUserPermissions()} style={{ background: '#2563eb', color: '#fff', border: 0, padding: '0.5rem 0.8rem', borderRadius: '4px', cursor: 'pointer' }}>Save access</button>
            </div>
          </div>
        </div>
      )}

      {/* Create Company Modal */}
      {showCreateTenantModal && (
        <div style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.7)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 9999 }}>
          <div style={{ background: '#1e293b', padding: '2rem', borderRadius: '8px', width: '100%', maxWidth: '500px', border: '1px solid #334155' }}>
            <h2 style={{ marginTop: 0, marginBottom: '1.25rem' }}>Add Company</h2>
            <form onSubmit={handleCreateTenant}>
              <label style={{ display: 'block', color: '#cbd5e1', marginBottom: '1rem' }}>
                Company Name
                <input type="text" required value={companyName} onChange={(e) => setCompanyName(e.target.value)} style={{ display: 'block', width: '100%', marginTop: '0.25rem', padding: '0.6rem', borderRadius: '4px', background: '#0f172a', border: '1px solid #334155', color: '#fff', boxSizing: 'border-box' }} placeholder="e.g. Oceanic Shipping Ltd" />
              </label>
              <label style={{ display: 'block', color: '#cbd5e1', marginBottom: '1rem' }}>
                Admin Full Name
                <input type="text" required value={adminFullName} onChange={(e) => setAdminFullName(e.target.value)} style={{ display: 'block', width: '100%', marginTop: '0.25rem', padding: '0.6rem', borderRadius: '4px', background: '#0f172a', border: '1px solid #334155', color: '#fff', boxSizing: 'border-box' }} placeholder="e.g. Captain Sarah Connor" />
              </label>
              <label style={{ display: 'block', color: '#cbd5e1', marginBottom: '1rem' }}>
                Admin Email
                <input type="email" required value={adminEmail} onChange={(e) => setAdminEmail(e.target.value)} style={{ display: 'block', width: '100%', marginTop: '0.25rem', padding: '0.6rem', borderRadius: '4px', background: '#0f172a', border: '1px solid #334155', color: '#fff', boxSizing: 'border-box' }} placeholder="admin@company.com" />
              </label>
              <label style={{ display: 'block', color: '#cbd5e1', marginBottom: '1rem' }}>
                Admin Password
                <input type="password" required minLength={8} value={adminPassword} onChange={(e) => setAdminPassword(e.target.value)} style={{ display: 'block', width: '100%', marginTop: '0.25rem', padding: '0.6rem', borderRadius: '4px', background: '#0f172a', border: '1px solid #334155', color: '#fff', boxSizing: 'border-box' }} placeholder="Min 8 characters" />
              </label>
              <label style={{ display: 'block', color: '#cbd5e1', marginBottom: '1.5rem' }}>
                Initial Enabled Modules
                <div style={{ display: 'flex', gap: '0.5rem', flexWrap: 'wrap', marginTop: '0.5rem' }}>
                  {modules.map((m) => (
                    <label key={m.id} style={{ display: 'flex', alignItems: 'center', gap: '0.3rem', fontSize: '0.85rem', color: '#cbd5e1' }}>
                      <input
                        type="checkbox"
                        checked={selectedInitialModules.includes(m.id)}
                        onChange={(e) => {
                          if (e.target.checked) {
                            setSelectedInitialModules([...selectedInitialModules, m.id]);
                          } else {
                            setSelectedInitialModules(selectedInitialModules.filter((id) => id !== m.id));
                          }
                        }}
                      />
                      {m.name}
                    </label>
                  ))}
                </div>
              </label>
              <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '0.75rem' }}>
                <button type="button" onClick={() => setShowCreateTenantModal(false)} style={{ background: '#334155', color: '#fff', border: 'none', padding: '0.5rem 1rem', borderRadius: '4px', cursor: 'pointer' }}>Cancel</button>
                <button type="submit" disabled={isSavingTenant} style={{ background: '#2563eb', color: '#fff', border: 'none', padding: '0.5rem 1.25rem', borderRadius: '4px', cursor: 'pointer' }}>{isSavingTenant ? 'Creating...' : 'Add Company'}</button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
