{
  "name": "fleetview-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FleetView React frontend (Phase 1 scaffold).",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"magenta.bold,cyan.bold\" \"npm run backend:run\" \"npm run dev\"",
    "dev:all": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"magenta.bold,cyan.bold\" \"npm run backend:run\" \"npm run dev\"",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "backend:run": "dotnet run --project backend/src/MultiTenantSaaS.API",
    "backend:watch": "dotnet watch --project backend/src/MultiTenantSaaS.API run",
    "backend:test": "dotnet test backend/MultiTenantSaaS.slnx",
    "test:antimeridian": "tsx scripts/testAntimeridian.mts",
    "seed:export": "tsx scripts/exportSeed.mts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.2",
    "@microsoft/signalr": "9.0.6",
    "d3-array": "^3.2.4",
    "d3-contour": "^4.0.2",
    "leaflet": "1.9.4",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38",
    "polygon-clipping": "^0.15.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "react-router-dom": "^6.27.0",
    "tesseract.js": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-contour": "^3.0.6",
    "@types/leaflet": "1.9.12",
    "@types/node": "^25.9.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.0",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
